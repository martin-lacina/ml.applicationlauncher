<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ML.ApplicationLauncher.Shared.ViewModels"
             xmlns:views="clr-namespace:ML.ApplicationLauncher.Shared.Views"
             xmlns:controls="clr-namespace:ML.ApplicationLauncher.Shared.Controls"
             x:Class="ML.ApplicationLauncher.Shared.Views.EditView">
    <UserControl.Resources>
    </UserControl.Resources>

    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <ToolBar.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Margin" Value="5,0,2,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </ToolBar.Resources>
            <Button ToolTip="Save Configuration" Command="{Binding SaveCommand}" MinWidth="24">
                <Image Source="pack://application:,,,/Resources/content-save-outline-custom.png" MaxHeight="24" />
            </Button>
            <Button ToolTip="Undo Last Change" Command="{Binding UndoCommand}" MinWidth="24">
                <Image Source="pack://application:,,,/Resources/undo-custom.png" MaxHeight="24" />
            </Button>
            <Button ToolTip="Redo Last Change" Command="{Binding RedoCommand}" MinWidth="24">
                <Image Source="pack://application:,,,/Resources/redo-custom.png" MaxHeight="24" />
            </Button>
            <Separator />
            <TextBlock Text="Groups" FontSize="14" />
            <Button ToolTip="Add Group" Command="{Binding AddGroupCommand}" MinWidth="24">
                <Image Source="pack://application:,,,/Resources/plus-thick-custom.png" MaxHeight="24" />
            </Button>
            <Button ToolTip="Add Subgroup" Command="{Binding AddSubGroupCommand}" MinWidth="24">
                <Image Source="pack://application:,,,/Resources/folder-plus-outline-custom.png" MaxHeight="24" />
            </Button>
            <Button ToolTip="Remove Selected Group" Command="{Binding RemoveGroupCommand}" MinWidth="24">
                <Image Source="pack://application:,,,/Resources/delete-empty-custom.png" MaxHeight="24" />
            </Button>
            <Button ToolTip="Move Group Up" Command="{Binding MoveUpGroupCommand}" MinWidth="24">
                <Image Source="pack://application:,,,/Resources/arrow-up-custom.png" MaxHeight="24" />
            </Button>
            <Button ToolTip="Move Group Down" Command="{Binding MoveDownGroupCommand}" MinWidth="24">
                <Image Source="pack://application:,,,/Resources/arrow-down-custom.png" MaxHeight="24" />
            </Button>
            <Separator />
            <TextBlock Text="Processes" FontSize="14" />
            <Button ToolTip="Add Process" Command="{Binding AddProcessCommand}" MinWidth="24">
                <Image Source="pack://application:,,,/Resources/shape-circle-plus-custom.png" MaxHeight="24" />
            </Button>
            <Button ToolTip="Duplicate Selected Process" Command="{Binding DuplicateSelectedProcessCommand}" MinWidth="24">
                <Image Source="pack://application:,,,/Resources/content-duplicate-custom.png" MaxHeight="24" />
            </Button>
            <Button ToolTip="Remove Selected Process" Command="{Binding RemoveSelectedProcessCommand}" MinWidth="24">
                <Image Source="pack://application:,,,/Resources/delete-empty-custom.png" MaxHeight="24" />
            </Button>
            <Button ToolTip="Move Process Up" Command="{Binding MoveUpProcessCommand}" MinWidth="24">
                <Image Source="pack://application:,,,/Resources/arrow-up-custom.png" MaxHeight="24" />
            </Button>
            <Button ToolTip="Move Process Down" Command="{Binding MoveDownProcessCommand}" MinWidth="24">
                <Image Source="pack://application:,,,/Resources/arrow-down-custom.png" MaxHeight="24" />
            </Button>
        </ToolBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MaxWidth="250" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" Margin="5,8,5,5" FontWeight="Bold" Text="Groups" />

            <TreeView x:Name="GroupsTreeView" Grid.Column="0" Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItemChanged="TreeView_SelectedItemChanged"
                      AllowDrop="True"
                      PreviewMouseLeftButtonDown="GroupsTreeView_PreviewMouseLeftButtonDown"
                      MouseMove="GroupsTreeView_MouseMove"
                      Drop="GroupsTreeView_Drop">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <TextBlock Grid.Column="1" Grid.Row="0" Margin="5,8,5,5" FontWeight="Bold" Text="Process definitions" />

            <Grid Grid.Column="1" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListView x:Name="ProcessesListView" Grid.Row="0" Grid.Column="0" ItemsSource="{Binding SelectedGroup.Processes}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="ProcessesListView_PreviewMouseLeftButtonDown"
                          MouseMove="ProcessesListView_MouseMove"
                          Drop="ProcessesListView_Drop">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" />
                            <GridViewColumn Header="Args" DisplayMemberBinding="{Binding Arguments}" />
                            <GridViewColumn>
                                <GridViewColumn.Header>
                                    <TextBlock Text="Actions" FontWeight="Bold" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:CommandProcessViewModel}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Width="30" Height="24" Margin="0,0,4,0"
                                                    Command="{Binding StartCommand}" IsEnabled="{Binding CanBeStarted}"
                                                    ToolTip="Start Process">
                                                <Image Source="pack://application:,,,/Resources/play-custom.png" MaxHeight="24" />
                                            </Button>
                                            <Button Width="30" Height="24" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.DuplicateProcessCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Duplicate Process">
                                                <Image Source="pack://application:,,,/Resources/content-duplicate-custom.png" MaxHeight="24" />
                                            </Button>
                                            <Button Width="30" Height="24"
                                                    Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Delete Process">
                                                <Image Source="pack://application:,,,/Resources/delete-empty-custom.png" MaxHeight="24" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2">
                    <ContentControl Content="{Binding SelectedDetail}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:CommandProcessViewModel}">
                                <controls:ProcessEditor />
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type vm:CommandGroupViewModel}">
                                <controls:ProcessGroupEditor />
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </ScrollViewer>

                <Expander Grid.Column="1" Grid.Row="0" Header="Process preview" IsExpanded="False" ExpandDirection="Left" Margin="5,8,5,5">
                    <Expander.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="Bold">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </DataTemplate>
                    </Expander.HeaderTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Process list -->
                            <controls:CommandGroupProcessList DataContext="{Binding SelectedGroup}">
                                <controls:CommandGroupProcessList.Style>
                                    <Style TargetType="controls:CommandGroupProcessList">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedGroup.Processes.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:CommandGroupProcessList.Style>
                            </controls:CommandGroupProcessList>

                            <!-- Empty state message -->
                            <TextBlock Text="No process definitions created"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedGroup.Processes.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
