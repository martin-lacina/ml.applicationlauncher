<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ML.ApplicationLauncher.Shared.ViewModels"
             xmlns:views="clr-namespace:ML.ApplicationLauncher.Shared.Views"
             xmlns:controls="clr-namespace:ML.ApplicationLauncher.Shared.Controls"
             x:Class="ML.ApplicationLauncher.Shared.Views.EditView">
    <UserControl.Resources>


        <!--<DataTemplate DataType="{x:Type vm:ProcessGroupViewModel}">
            <controls:ProcessGroupView />
        </DataTemplate>-->
    </UserControl.Resources>

    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Add Group" Command="{Binding AddGroupCommand}" />
            <Button Content="Add Process" Command="{Binding AddProcessCommand}" />
            <Button Content="Remove" Command="{Binding RemoveCommand}" />
            <Button Content="Move Up" Command="{Binding MoveUpCommand}" />
            <Button Content="Move Down" Command="{Binding MoveDownCommand}" />
            <Separator />
            <Button Content="Save" Command="{Binding SaveCommand}" />
            <Button Content="Undo" Command="{Binding UndoCommand}" />
            <Button Content="Redo" Command="{Binding RedoCommand}" />
        </ToolBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" Margin="5,8,5,5" FontWeight="Bold" Text="Groups" />

            <TreeView x:Name="GroupsTreeView" Grid.Column="0" Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItemChanged="TreeView_SelectedItemChanged"
                      AllowDrop="True"
                      PreviewMouseLeftButtonDown="GroupsTreeView_PreviewMouseLeftButtonDown"
                      MouseMove="GroupsTreeView_MouseMove"
                      Drop="GroupsTreeView_Drop">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <TextBlock Grid.Column="1" Grid.Row="0" Margin="5,8,5,5" FontWeight="Bold" Text="Process definitions" />

            <Grid Grid.Column="1" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <ListView x:Name="ProcessesListView" Grid.Row="0" ItemsSource="{Binding SelectedGroup.Processes}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="ProcessesListView_PreviewMouseLeftButtonDown"
                          MouseMove="ProcessesListView_MouseMove"
                          Drop="ProcessesListView_Drop">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" />
                            <GridViewColumn Header="Args" DisplayMemberBinding="{Binding Arguments}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <ContentControl Grid.Row="1" Content="{Binding SelectedDetail}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:CommandProcessViewModel}">
                            <views:ProcessDetailsControl />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:CommandGroupViewModel}">
                            <StackPanel Margin="8">
                                <TextBlock Text="Group Details" FontWeight="Bold" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Name:" Width="60" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Width="300" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>

            <TextBlock Grid.Column="2" Grid.Row="0" Margin="5,8,5,5" FontWeight="Bold" Text="Process preview" />

            <Grid Grid.Column="2" Grid.Row="1">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Process list -->
                        <controls:CommandGroupProcessList DataContext="{Binding SelectedGroup}">
                            <controls:CommandGroupProcessList.Style>
                                <Style TargetType="controls:CommandGroupProcessList">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedGroup.Processes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:CommandGroupProcessList.Style>
                        </controls:CommandGroupProcessList>

                        <!-- Empty state message -->
                        <TextBlock Text="No process definitions created"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedGroup.Processes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
