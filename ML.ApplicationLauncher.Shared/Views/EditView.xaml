<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ML.ApplicationLauncher.Shared.ViewModels"
             xmlns:views="clr-namespace:ML.ApplicationLauncher.Shared.Views"
             xmlns:controls="clr-namespace:ML.ApplicationLauncher.Shared.Controls"
             x:Class="ML.ApplicationLauncher.Shared.Views.EditView">
    <UserControl.Resources>


        <!--<DataTemplate DataType="{x:Type vm:ProcessGroupViewModel}">
            <controls:ProcessGroupView />
        </DataTemplate>-->
    </UserControl.Resources>

    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="➕" ToolTip="Add Group" Command="{Binding AddGroupCommand}" />
            <Button Content="📁" ToolTip="Add Subgroup" Command="{Binding AddSubGroupCommand}" />
            <Button Content="📄" ToolTip="Add Process" Command="{Binding AddProcessCommand}" />
            <Button Content="🗑️" ToolTip="Remove Selected" Command="{Binding RemoveCommand}" />
            <Separator />
            <Button Content="⬆️" ToolTip="Move Up" Command="{Binding MoveUpCommand}" />
            <Button Content="⬇️" ToolTip="Move Down" Command="{Binding MoveDownCommand}" />
            <Separator />
            <Button Content="💾" ToolTip="Save Configuration" Command="{Binding SaveCommand}" />
            <Button Content="↩️" ToolTip="Undo Last Change" Command="{Binding UndoCommand}" />
            <Button Content="↪️" ToolTip="Redo Last Change" Command="{Binding RedoCommand}" />
        </ToolBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MaxWidth="250" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="Auto" MaxWidth="300" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" Margin="5,8,5,5" FontWeight="Bold" Text="Groups" />

            <TreeView x:Name="GroupsTreeView" Grid.Column="0" Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItemChanged="TreeView_SelectedItemChanged"
                      AllowDrop="True"
                      PreviewMouseLeftButtonDown="GroupsTreeView_PreviewMouseLeftButtonDown"
                      MouseMove="GroupsTreeView_MouseMove"
                      Drop="GroupsTreeView_Drop">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <TextBlock Grid.Column="1" Grid.Row="0" Margin="5,8,5,5" FontWeight="Bold" Text="Process definitions" />

            <Grid Grid.Column="1" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView x:Name="ProcessesListView" Grid.Row="0" ItemsSource="{Binding SelectedGroup.Processes}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="ProcessesListView_PreviewMouseLeftButtonDown"
                          MouseMove="ProcessesListView_MouseMove"
                          Drop="ProcessesListView_Drop">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" />
                            <GridViewColumn Header="Args" DisplayMemberBinding="{Binding Arguments}" />
                            <GridViewColumn>
                                <GridViewColumn.Header>
                                    <TextBlock Text="Actions" FontWeight="Bold" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:CommandProcessViewModel}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="▶" Width="30" Height="22" Margin="0,0,4,0"
                                                    Command="{Binding StartCommand}" IsEnabled="{Binding CanBeStarted}"
                                                    ToolTip="Start Process" />
                                            <Button Content="🗑" Width="30" Height="22"
                                                    Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Delete Process" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding SelectedDetail}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:CommandProcessViewModel}">
                                <controls:ProcessEditor />
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type vm:CommandGroupViewModel}">
                                <controls:ProcessGroupEditor />
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </ScrollViewer>
            </Grid>

            <Expander Grid.Column="2" Grid.Row="1" Header="Process preview" IsExpanded="False" ExpandDirection="Left" Margin="5,8,5,5">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Process list -->
                        <controls:CommandGroupProcessList DataContext="{Binding SelectedGroup}">
                            <controls:CommandGroupProcessList.Style>
                                <Style TargetType="controls:CommandGroupProcessList">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedGroup.Processes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:CommandGroupProcessList.Style>
                        </controls:CommandGroupProcessList>

                        <!-- Empty state message -->
                        <TextBlock Text="No process definitions created"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedGroup.Processes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Expander>
        </Grid>
    </DockPanel>
</UserControl>
