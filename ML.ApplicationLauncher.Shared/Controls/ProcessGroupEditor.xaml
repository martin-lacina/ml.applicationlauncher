<ContentControl x:Class="ML.ApplicationLauncher.Shared.Controls.ProcessGroupEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:ML.ApplicationLauncher.Shared.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModels:CommandGroupViewModel, IsDesignTimeCreatable=False}">
    <StackPanel Margin="10">
        <!-- Editor Header -->
        <TextBlock Text="Edit Command Group" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

        <!-- Basic Properties Section -->
        <GroupBox Header="Basic Properties" Margin="0,5,0,0">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Display Name:" VerticalAlignment="Center" Margin="0,5" />
                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="2" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Comment:" VerticalAlignment="Center" Margin="0,5" />
                    <TextBox Grid.Column="1" Text="{Binding Comment}" Margin="2" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Configuration Options Section -->
        <GroupBox Header="Configuration" Margin="0,5,0,0">
            <StackPanel Margin="10">
                <CheckBox Content="Can Launch" IsChecked="{Binding CanLaunch}" Margin="5" />
                <CheckBox Content="Disabled" IsChecked="{Binding Disabled}" Margin="5" />
                <CheckBox Content="Hidden" IsChecked="{Binding Hidden}" Margin="5" />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</ContentControl>
