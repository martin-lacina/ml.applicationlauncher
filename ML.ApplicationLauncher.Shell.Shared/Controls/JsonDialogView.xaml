<UserControl x:Class="ML.ApplicationLauncher.Shell.Controls.JsonDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ML.ApplicationLauncher.Shell.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:JsonDialogViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TreeView x:Name="Tree" ItemsSource="{Binding Path=Items, Mode=OneWay}" Margin="5">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type viewModels:TreeItemViewModel}"
                                          ItemsSource="{Binding Path=Children, Mode=OneWay}">
                    <StackPanel Orientation="Vertical" Margin="0,2">
                        <TextBlock Text="{Binding Path=Header, Mode=OneWay}" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding Path=Details, Mode=OneWay}" Margin="12,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Close" Click="Close" IsDefault="True" MinWidth="80" Margin="0,0,5,5" />
        </StackPanel>
    </Grid>
</UserControl>
