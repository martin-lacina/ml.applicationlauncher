<prism:PrismApplication
    x:Class="ML.ApplicationLauncher.Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ML.ApplicationLauncher.Shell"
    xmlns:prism="http://prismlibrary.com/"
    >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type sharedVM:EditViewModel}" xmlns:sharedVM="clr-namespace:ML.ApplicationLauncher.Shell.Shared.ViewModels"
                          xmlns:sharedViews="clr-namespace:ML.ApplicationLauncher.Shell.Shared.Views">
                <sharedViews:EditView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
